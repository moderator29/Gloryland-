# Server-side only. These are read by the functions in api/ and must never be
# prefixed with VITE_, because Vite inlines every VITE_ value into the browser
# bundle in plain text.

# Powers /app/copilot and /app/support. Without it both surfaces render an
# honest "not connected" state rather than failing on the first message.
ANTHROPIC_API_KEY=

# Shared secret for the content publisher at api/feed/publish.
# Optional. Leave unset and the endpoint stays disabled, which is fine:
# Signal ships with a seeded post set and works without it.
# Generate with: openssl rand -hex 32
PUBLISH_SECRET=

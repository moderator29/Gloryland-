    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://rigel.capital/legal/privacy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://rigel.capital/legal/changes</loc>
